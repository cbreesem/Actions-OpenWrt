# This is an empty file, please overwrite it after generating the .config file with the source code
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_aliyun_ap8220=y

# ------------------------------
# 1. 异地组网与 VPN (WireGuard / UDP 隧道)
# ------------------------------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y

# ------------------------------
# 2. sing-box / 透明代理核心驱动
# ------------------------------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ------------------------------
# 3. 拓扑与虚拟化 (VLAN 单线复用 / Macvlan)
# ------------------------------
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_kmod-macvlan=y

# ------------------------------
# 4. 外置存储支持 (确保 sda1 随开机即挂载)
# ------------------------------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ------------------------------
# 5. 基础网络工具与 HTTPS 证书
# ------------------------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
